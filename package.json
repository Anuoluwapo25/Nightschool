{
  "name": "nightschool",
  "version": "0.1.0",
  "private": true,
  "description": "Learn Midnight by solving challenges on it: answers proved in zero knowledge, rewards that cannot be farmed.",
  "type": "module",
  "workspaces": [
    "packages/contract",
    "packages/api",
    "packages/cli",
    "packages/ui"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "compact": "npm run compact -w @nightschool/contract",
    "build": "npm run build -w @nightschool/contract && npm run build -w @nightschool/api && npm run build -w @nightschool/cli",
    "test": "npm run test -w @nightschool/contract",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/onchain-runtime-v3": "3.1.0"
  }
}
